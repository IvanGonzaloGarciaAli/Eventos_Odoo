<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tarea_tree" model="ir.ui.view">
            <field name="name">igga_eventos.tarea.tree</field>
            <field name="model">igga_eventos.tarea</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="descripcion"/>
                    <field name="responsable_id"/>
                    <field name="fecha_limite"/>
                    <field name="estado"/>
                    <field name="evento_id"/>
                </tree>
            </field>
        </record>
    </data>
    
     <data>
        <record id="view_tarea_form" model="ir.ui.view">
            <field name="name">igga_eventos.tarea.form</field>
            <field name="model">igga_eventos.tarea</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="descripcion"/>
                            <field name="responsable_id"/>
                            <field name="fecha_limite"/>
                            <field name="estado"/>
                            <field name="evento_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
