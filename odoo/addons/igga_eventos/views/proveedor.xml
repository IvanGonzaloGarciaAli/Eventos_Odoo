<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    
        <record id="view_proveedor_tree" model="ir.ui.view">
            <field name="name">igga_eventos.proveedor.tree</field>
            <field name="model">igga_eventos.proveedor</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nombre"/>
                    <field name="servicio"/>
                    <field name="costo"/>
                </tree>
            </field>
        </record>

        <record id="view_proveedor_form" model="ir.ui.view">
            <field name="name">igga_eventos.proveedor.form</field>
            <field name="model">igga_eventos.proveedor</field>
            <field name="arch" type="xml">
                 <form>
                    <sheet>
                        <group>
                            <field name="nombre"/>
                            <field name="servicio"/>
                            <field name="costo"/>
                        </group>

                        <group string="Eventos Asociados">
                            <field name="evento_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="fecha"/>
                                    <field name="lugar"/>
                                    <field name="estado"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    
    </data>
    
</odoo>
