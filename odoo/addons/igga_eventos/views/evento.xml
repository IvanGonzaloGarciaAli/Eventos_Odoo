<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Tree -->
        <record id="view_evento_tree" model="ir.ui.view">
            <field name="name">igga_eventos.evento.tree</field>
            <field name="model">igga_eventos.evento</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="lugar"/>
                    <field name="cliente_id"/>
                    <field name="estado"/>
                    <!-- Campo calculado -->
                    <field name="total_costo"/>
                </tree>
            </field>
        </record>

        <!-- Vista Form -->
        <record id="view_evento_form" model="ir.ui.view">
            <field name="name">igga_eventos.evento.form</field>
            <field name="model">igga_eventos.evento</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="fecha"/>
                            <field name="lugar"/>
                            <field name="cliente_id"/>
                            <field name="estado"/>
                            <field name="imagen" widget="image"/>
                            <!-- Campo calculado que solo se puede leer -->
                            <field name="total_costo" readonly="1"/>
                        </group>
                        <!-- Datos de tareas dentro de eventos -->
                        <group string="Tareas">
                            <field name="tarea_ids">
                                <tree>
                                    <field name="descripcion"/>
                                    <field name="responsable_id"/>
                                    <field name="fecha_limite"/>
                                    <field name="estado"/>
                                </tree>
                            </field>
                        </group>
                        <!-- Datos de invitados dentro de Eventos -->
                        <group string="Invitados">
                            <field name="invitado_ids">
                                <tree>
                                    <field name="nombre"/>
                                    <field name="email"/>
                                    <field name="confirmacion"/>
                                </tree>
                            </field>
                        </group>
                        <!-- Datos de proveedores dentro de eventos -->
                        <group string="Proveedores">
                            <field name="proveedor_ids">
                                <tree>
                                    <field name="nombre"/>
                                    <field name="servicio"/>
                                    <field name="costo"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Vista Kanban -->
        <record id="view_evento_kanban" model="ir.ui.view">
            <field name="name">igga_eventos.evento.kanban</field>
            <field name="model">igga_eventos.evento</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="estado"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_image">
                                    <!-- Imagen dentro de la vista Kanban -->
                                    <field name = "imagen" widget="image" options="{'size':(100, 100)}"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong><field name="name"/></strong>
                                    <div><field name="fecha"/></div>
                                    <div><field name="estado"/></div>
                                    <!-- Campo calculado en negrita -->
                                    <div><strong>Total Costo:</strong> <field name="total_costo"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                    
                </kanban>
            </field>
        </record>
        <!-- Vista Calendar -->
        <record id="view_evento_calendar" model="ir.ui.view">
            <field name="name">igga_eventos.evento.calendar</field>
            <field name="model">igga_eventos.evento</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de Eventos" date_start="fecha">
                    <field name="name"/>
                    <field name="cliente_id"/>
                    <field name="estado"/>
                </calendar>
            </field>
        </record>


    </data>
    

</odoo>
