<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_evento_tree" model="ir.ui.view">
            <field name="name">igga_eventos.evento.tree</field>
            <field name="model">igga_eventos.evento</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="lugar"/>
                    <field name="cliente_id"/>
                    <field name="estado"/>
                </tree>
            </field>
        </record>


        <record id="view_evento_form" model="ir.ui.view">
            <field name="name">igga_eventos.evento.form</field>
            <field name="model">igga_eventos.evento</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="fecha"/>
                            <field name="lugar"/>
                            <field name="cliente_id"/>
                            <field name="estado"/>
                            <field name="imagen" widget="image"/>
                        </group>

                        <group string="Tareas">
                            <field name="tarea_ids">
                                <tree>
                                    <field name="descripcion"/>
                                    <field name="responsable_id"/>
                                    <field name="fecha_limite"/>
                                    <field name="estado"/>
                                </tree>
                            </field>
                        </group>

                        <group string="Invitados">
                            <field name="invitado_ids">
                                <tree>
                                    <field name="nombre"/>
                                    <field name="email"/>
                                    <field name="confirmacion"/>
                                </tree>
                            </field>
                        </group>

                        <group string="Proveedores">
                            <field name="proveedor_ids">
                                <tree>
                                    <field name="nombre"/>
                                    <field name="servicio"/>
                                    <field name="costo"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_evento_kanban" model="ir.ui.view">
            <field name="name">igga_eventos.evento.kanban</field>
            <field name="model">igga_eventos.evento</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="estado"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_image">
                                    <field name = "imagen" widget="image" options="{'size':(100, 100)}"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong><field name="name"/></strong>
                                    <div><field name="fecha"/></div>
                                    <div><field name="estado"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>

                    <kanban_column name="planificacion" string="Planificación">
                        <kanban_default>
                            <field name="estado" eval="'planificacion'"/>
                        </kanban_default>
                    </kanban_column>

                    <kanban_column name="en_curso" string="En Curso">
                        <kanban_default>
                            <field name="estado" eval="'en_curso'"/>
                        </kanban_default>
                    </kanban_column>

                    <kanban_column name="finalizado" string="Finalizado">
                        <kanban_default>
                            <field name="estado" eval="'finalizado'"/>
                        </kanban_default>
                    </kanban_column>

                </kanban>
            </field>
        </record>

    </data>
    

</odoo>
